BOT_TOKEN=1234567890:replace_me
DATABASE_URL=sqlite+aiosqlite:///autoparts.db
LOG_LEVEL=INFO

# Search aggregation
SEARCH_CACHE_BACKEND=memory
REDIS_URL=
SEARCH_CACHE_TTL_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
RATE_LIMIT_BACKEND=memory
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

# Procurement estimate
PROCUREMENT_SHIPPING_FEE=500
PROCUREMENT_FREE_SHIPPING_THRESHOLD=10000
PROCUREMENT_PROVIDER_RULES_JSON=

# Demo data
DEMO_PROVIDER_ENABLED=true
DEMO_FITMENT_ENABLED=true

# External price / stock provider
EXTERNAL_PROVIDER_ENABLED=false
EXTERNAL_PROVIDER_NAME=Partner API
EXTERNAL_PROVIDER_BASE_URL=
EXTERNAL_PROVIDER_SEARCH_PATH=/search
EXTERNAL_PROVIDER_API_KEY=
EXTERNAL_PROVIDER_API_KEY_HEADER=Authorization
EXTERNAL_PROVIDER_AUTH_SCHEME=Bearer
EXTERNAL_PROVIDER_ALLOW_HTTP=false

# External checkout / order API for one provider
CHECKOUT_API_ENABLED=false
CHECKOUT_API_PROVIDER_NAME=Partner API
CHECKOUT_API_BASE_URL=
CHECKOUT_API_CREATE_PATH=/orders
CHECKOUT_API_STATUS_PATH=/orders/{external_order_id}
CHECKOUT_API_CANCEL_PATH=/orders/{external_order_id}/cancel
CHECKOUT_API_KEY=
CHECKOUT_API_KEY_HEADER=Authorization
CHECKOUT_API_AUTH_SCHEME=Bearer
CHECKOUT_API_ALLOW_HTTP=false
CHECKOUT_API_TIMEOUT_SECONDS=10
CHECKOUT_API_EXTRA_PAYLOAD_JSON=

# External fitment catalog
FITMENT_API_ENABLED=false
FITMENT_API_BASE_URL=
FITMENT_API_RESOLVE_PATH=/fitment/resolve
FITMENT_API_KEY=
FITMENT_API_KEY_HEADER=Authorization
FITMENT_API_AUTH_SCHEME=Bearer
FITMENT_API_ALLOW_HTTP=false

# External vehicle / VIN resolver
VEHICLE_API_ENABLED=false
VEHICLE_API_BASE_URL=
VEHICLE_API_VIN_PATH=/vehicle/vin
VEHICLE_API_KEY=
VEHICLE_API_KEY_HEADER=Authorization
VEHICLE_API_AUTH_SCHEME=Bearer
VEHICLE_API_ALLOW_HTTP=false

# Price alerts
PRICE_ALERTS_ENABLED=true
PRICE_ALERT_WORKER_MODE=embedded
PRICE_ALERT_INTERVAL_SECONDS=3600
PRICE_ALERT_DROP_PERCENT=5

# External order status monitoring
ORDER_STATUS_MONITOR_ENABLED=false
ORDER_STATUS_INTERVAL_SECONDS=300

# Telegram runtime
BOT_RUN_MODE=polling
WEBHOOK_URL=
WEBHOOK_PATH=/webhook
WEBHOOK_HOST=0.0.0.0
WEBHOOK_PORT=8080
WEBHOOK_SECRET_TOKEN=
