# Required
BOT_TOKEN=1234567890:replace_me
POSTGRES_PASSWORD=change-me

# Runtime
LOG_LEVEL=INFO
BOT_RUN_MODE=polling

# For webhook deployment:
# BOT_RUN_MODE=webhook
# WEBHOOK_URL=https://bot.example.com/webhook
# WEBHOOK_PATH=/webhook
# WEBHOOK_PORT=8080
# WEBHOOK_SECRET_TOKEN=change-me

# Production data sources: configure real APIs and turn demo off.
DEMO_PROVIDER_ENABLED=false
DEMO_FITMENT_ENABLED=false

EXTERNAL_PROVIDER_ENABLED=false
EXTERNAL_PROVIDER_BASE_URL=
EXTERNAL_PROVIDER_API_KEY=

FITMENT_API_ENABLED=false
FITMENT_API_BASE_URL=
FITMENT_API_KEY=

VEHICLE_API_ENABLED=false
VEHICLE_API_BASE_URL=
VEHICLE_API_KEY=

# Shared infrastructure is injected by docker-compose.prod.yml.
SEARCH_CACHE_TTL_SECONDS=60
PROVIDER_TIMEOUT_SECONDS=5
PROVIDER_CIRCUIT_FAILURE_THRESHOLD=3
PROVIDER_CIRCUIT_COOLDOWN_SECONDS=60
RATE_LIMIT_REQUESTS=60
RATE_LIMIT_WINDOW_SECONDS=60

PRICE_ALERTS_ENABLED=true
PRICE_ALERT_INTERVAL_SECONDS=3600
PRICE_ALERT_WORKER_MODE=external
